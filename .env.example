# Travel Manager - Variáveis de Ambiente

# Aplicação
APP_NAME=Travel Manager
APP_ENV=development
APP_SECRET_KEY=sua_chave_secreta_super_segura_aqui_com_no_minimo_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Banco de Dados (PostgreSQL para Docker/Produção, SQLite local opcional)
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_secret_password
POSTGRES_DB=travel_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://travel_user:travel_secret_password@postgres:5432/travel_manager

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Armazenamento e Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# IA & Provedores Externos
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=

# E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=contato@travelmanager.local
EMAILS_FROM_NAME="Travel Manager"

# Notificações Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@travelmanager.local
