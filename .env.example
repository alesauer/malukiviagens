# ========================================================
# Maluki Viagens - Configuração de Ambiente para VPS
# ========================================================

# 1. Domínio e URL da Aplicação
SITE_DOMAIN=viagens.seudominio.com
SITE_URL=https://viagens.seudominio.com
ACME_EMAIL=admin@seudominio.com

# 2. Banco de Dados PostgreSQL & Autenticação Supabase
# Dica: Execute "node docker/generate-keys.mjs" para gerar chaves seguras aleatórias!
POSTGRES_PASSWORD=sua_senha_forte_do_postgres
JWT_SECRET=seu_jwt_secret_com_mais_de_32_caracteres
SUPABASE_ANON_KEY=seu_jwt_anon_gerado
SUPABASE_SERVICE_ROLE_KEY=seu_jwt_service_role_gerado

# 3. Confirmação de Cadastro por E-mail
# true: ativa contas imediatamente sem exigir servidor SMTP
# false: envia link de confirmação (requer configuração de SMTP no GoTrue)
MAILER_AUTOCONFIRM=true

# 4. Assistente de IA (DeepSeek)
# Obtenha sua chave em https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-sua-chave-api-deepseek

# 5. Google OAuth (Opcional)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
