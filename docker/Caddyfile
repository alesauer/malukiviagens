{
  email {$ACME_EMAIL:admin@example.com}
}

# Single domain setup (Default & Recommended)
# All /auth/v1, /rest/v1, /storage/v1 routes go to Kong API Gateway
# All other frontend & SSR traffic goes to TanStack Start App
{$SITE_DOMAIN:localhost} {
  # Supabase APIs through Kong Gateway
  handle /auth/v1/* {
    reverse_proxy kong:8000
  }
  handle /rest/v1/* {
    reverse_proxy kong:8000
  }
  handle /storage/v1/* {
    reverse_proxy kong:8000
  }

  # Frontend & TanStack Start Server
  handle {
    reverse_proxy app:3000
  }
}
